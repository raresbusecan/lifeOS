{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "lifeos://dcs/transition.schema.json",
    "title": "LifeOS DCS Transition",
    "type": "object",
    "additionalProperties": false,
    "required": ["taskId", "from", "to", "actor", "reason", "timestamp"],
    "properties": {
        "taskId": {"type": "string"},
        "from": {"type": "string"},
        "to": {"type": "string"},
        "actor": {"type": "string"},
        "reason": {"type": "string"},
        "evidence": {"type": "array", "items": {"type": "string"}},
        "timestamp": {"type": "string"}
    }
}